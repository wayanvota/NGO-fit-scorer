# ---------------------------------------------------------------------------
# Funding Fit Scorer (template) - environment configuration
# Copy to .env for local dev. On Render, set these as environment variables.
# Branding lives in org_config.json (copy org_config.example.json). Secrets and
# access control live here.
# ---------------------------------------------------------------------------

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string

# Database. Blank = local SQLite file (dev). For production, paste the Neon
# pooled connection string (postgresql://...).
DATABASE_URL=

# --- Access control ---
# Comma-separated email domains allowed to sign in (your staff).
ALLOWED_EMAIL_DOMAINS=example.org
# Comma-separated emails granted admin on first login.
INITIAL_ADMIN_EMAILS=

# Dev login: passwordless email login for allowed domains when Google OAuth is
# not configured. NEVER enable in production.
DEV_AUTH=true

# --- Google OAuth (production sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=http://localhost:8000

# --- Anthropic / Claude ---
# Blank = MOCK mode (heuristic scoring, no API calls). Set your key for real use.
ANTHROPIC_API_KEY=
# Confirm current IDs at https://platform.claude.com/docs/en/about-claude/models/overview
STRONG_MODEL=claude-sonnet-5
FAST_MODEL=claude-haiku-4-5
RECAL_MODEL=claude-opus-4-8

# --- Recalibration ---
RECAL_CADENCE_DAYS=90
RECAL_MIN_OUTCOMES=15
